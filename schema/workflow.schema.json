{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 24,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          },
          "image": {
            "type": "object",
            "properties": {
              "nix": {
                "type": "string",
                "maxLength": 4096,
                "pattern": "^[^-\\x00\\r\\n][^\\x00\\r\\n]*$"
              }
            },
            "required": [
              "nix"
            ],
            "additionalProperties": false
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            }
          },
          "args": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "resources": {
            "type": "object",
            "properties": {
              "cores": {
                "type": "integer",
                "minimum": 1
              },
              "memory_mib": {
                "type": "integer",
                "minimum": 1
              },
              "gpus": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "cores",
              "memory_mib"
            ],
            "additionalProperties": false
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 32768,
              "pattern": "^[^\\x00]*$"
            },
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "not": {
                "pattern": "^NVIDIA_"
              }
            }
          },
          "network": {
            "type": "string",
            "enum": [
              "none",
              "egress"
            ]
          },
          "cap_add": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "enum": [
                "NET_ADMIN"
              ]
            },
            "uniqueItems": true
          },
          "secrets": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "not": {
                "pattern": "^NVIDIA_"
              }
            },
            "uniqueItems": true
          },
          "services": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            },
            "uniqueItems": true
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31536000
          },
          "tags": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            },
            "uniqueItems": true
          },
          "retry": {
            "type": "object",
            "properties": {
              "task": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "infrastructure": {
                "type": [
                  "null",
                  "integer"
                ],
                "minimum": 0,
                "maximum": 10
              }
            },
            "additionalProperties": false
          },
          "depends_on": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "from": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            }
          }
        },
        "required": [
          "image",
          "resources",
          "id"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ordo workflow",
  "required": [
    "id",
    "tasks"
  ],
  "additionalProperties": false
}
